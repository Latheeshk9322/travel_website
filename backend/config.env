# Database Configuration (Using SQLite for easier setup)
DATABASE_URL=sqlite:./travel_app.db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production_123456789
JWT_EXPIRE=30d

# Stripe API Keys (Replace with your actual keys for production)
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef
STRIPE_SECRET_KEY=sk_test_51234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# Razorpay API Keys (Replace with your actual keys for production)
RAZORPAY_KEY_ID=rzp_test_1234567890
RAZORPAY_KEY_SECRET=1234567890abcdef

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Server Configuration
PORT=5000
NODE_ENV=development